        "import joblib\n",
        "\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier, AdaBoostClassifier\n",
        "from xgboost import XGBClassifier\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    confusion_matrix, matthews_corrcoef, roc_auc_score,\n",
        "    average_precision_score, precision_recall_curve, roc_curve, recall_score,\n",
        "    accuracy_score, precision_score, f1_score, auc\n",
        ")\n",
        "\n",
        "# =============== Versions (so you can confirm \"same version\") ===============\n",
        "print(\"Versions:\",\n",
        "      json.dumps({\n",
        "          \"python\": sys.version.split()[0],\n",
        "          \"numpy\": np.__version__,\n",
        "          \"pandas\": pd.__version__,\n",
        "          \"scikit_learn\": __import__(\"sklearn\").__version__,\n",
        "          \"xgboost\": __import__(\"xgboost\").__version__,\n",
        "          \"joblib\": joblib.__version__,\n",
        "      }, indent=2))\n",
        "\n",
        "# ==============================\n",
        "# 1) Define Models\n",
        "# ==============================\n",
        "def get_models(random_state=42):\n",
        "    return {\n",
        "        'Random Forest': RandomForestClassifier(n_estimators=100, random_state=random_state),\n",
        "        'Gradient Boosting': GradientBoostingClassifier(n_estimators=100, random_state=random_state),\n",
        "        'XGBoost': XGBClassifier(\n",
        "            eval_metric='logloss',\n",
        "            random_state=random_state,\n",
        "            use_label_encoder=False  # harmless on newer xgboost; ignored if unsupported\n",
        "        ),\n",
        "        'AdaBoost': AdaBoostClassifier(n_estimators=100, random_state=random_state),\n",
        "        'SVM': SVC(probability=True, random_state=random_state),\n",
        "    }\n",
        "\n",
        "# ==============================\n",
        "# 2) Safe metric helpers\n",
        "# ==============================\n",
        "def safe_roc_auc(y_true, y_prob):\n",
        "    # ROC-AUC undefined if only one class present in y_true\n",
        "    try:\n",
        "        if y_prob is None or len(np.unique(y_true)) < 2:\n",
        "            return np.nan\n",
        "        return roc_auc_score(y_true, y_prob)\n",
        "    except Exception:\n",
        "        return np.nan\n",
        "\n",
        "def pr_auc_pair(y_true, y_prob):\n",
        "    \"\"\"\n",
        "    Returns (AP, PR_AUC_trapz).\n",
        "    - AP = average_precision_score (step-wise interpolation, sklearn default)\n",
        "    - PR_AUC_trapz = trapezoidal area under PR curve (more \"curve-like\")\n",
        "    \"\"\"\n",
        "    if y_prob is None or len(np.unique(y_true)) < 2:\n",
        "        return (np.nan, np.nan)\n",
        "    try:\n",
        "        ap = average_precision_score(y_true, y_prob)\n",
        "        precision, recall, _ = precision_recall_curve(y_true, y_prob)\n",
        "        pr_auc_trapz = auc(recall, precision)  # recall is x-axis\n",
        "        return (ap, pr_auc_trapz)\n",
        "    except Exception:\n",
        "        return (np.nan, np.nan)\n",
        "\n",
        "# ==============================\n",
        "# 3) Training + Evaluation\n",
        "# ==============================\n",
        "def evaluate_and_save(X_train, y_train, X_test, y_test, dataset_name, save_dir=\"models\"):\n",
        "    os.makedirs(save_dir, exist_ok=True)\n",
        "    results = []\n",
        "\n",
        "    # Flatten labels to 1D\n",
        "    y_train = np.ravel(y_train)\n",
        "    y_test  = np.ravel(y_test)\n",
        "\n",
        "    models = get_models()\n",
        "    for name, model in models.items():\n",
        "        print(f\"\\nTraining {name} on {dataset_name}...\")\n",
        "        model.fit(X_train, y_train)\n",
        "\n",
        "        y_pred = model.predict(X_test)\n",
        "        y_prob = model.predict_proba(X_test)[:, 1] if hasattr(model, \"predict_proba\") else None\n",
        "\n",
        "        # Metrics\n",
        "        acc  = accuracy_score(y_test, y_pred)\n",
        "        prec = precision_score(y_test, y_pred, zero_division=0)\n",
        "        rec  = recall_score(y_test, y_pred, zero_division=0)\n",
        "        f1   = f1_score(y_test, y_pred, zero_division=0)\n",
        "        mcc  = matthews_corrcoef(y_test, y_pred) if len(np.unique(y_pred)) > 1 else 0.0\n",
        "        roc  = safe_roc_auc(y_test, y_prob)\n",
        "        ap, pr_trapz = pr_auc_pair(y_test, y_prob)\n",
        "        cm   = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "        # Save model (same naming)\n",
        "        model_path = os.path.join(save_dir, f\"{dataset_name}_{name.replace(' ', '')}.joblib\")\n",
        "        joblib.dump(model, model_path)\n",
        "\n",
        "        # Save results\n",
        "        results.append({\n",
        "            \"Dataset\": dataset_name,\n",
        "            \"Model\": name,\n",
        "            \"Accuracy\": acc,\n",
        "            \"Precision\": prec,\n",
        "            \"Recall\": rec,\n",
        "            \"F1\": f1,\n",
        "            \"MCC\": mcc,\n",
        "            \"ROC-AUC\": roc,\n",
        "            \"PR-AUC (AP)\": ap,\n",
        "            \"PR-AUC (trapz)\": pr_trapz,\n",
        "            \"Confusion Matrix\": cm.tolist()\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(results)\n",
        "\n",
        "# ==============================\n",
        "# 4) Load & clean data (assumes variables already exist)\n",
        "# ==============================\n",
        "# If the feature frames include a 'Sequence' column, drop it.\n",
        "for var in [\"XP_train\",\"XP_test\",\"XE_train\",\"XE_test\",\"XK_train\",\"XK_test\"]:\n",
        "    if var in locals() and isinstance(locals()[var], pd.DataFrame):\n",
        "        if \"Sequence\" in locals()[var].columns:\n",
        "            locals()[var] = locals()[var].drop(columns=[\"Sequence\"])\n",
        "\n",
        "# ==============================\n",
        "# 5) Run for all datasets\n",
        "# ==============================\n",
        "results_P = evaluate_and_save(XP_train, yP_train, XP_test, yP_test, \"PeptideP\")\n",
        "results_E = evaluate_and_save(XE_train, yE_train, XE_test, yE_test, \"PeptideE\")\n",
        "results_K = evaluate_and_save(XK_train, yK_train, XK_test, yK_test, \"PeptideK\")\n",
        "\n",
        "# Combine & save\n",
        "all_results = pd.concat([results_P, results_E, results_K], ignore_index=True)\n",
        "all_results.to_csv(\"model_results.csv\", index=False)\n",
        "\n",
        "print(\"\\n✅ Training completed. Results saved to model_results.csv\")\n"
